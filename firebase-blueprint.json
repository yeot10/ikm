{
  "entities": {
    "User": {
      "title": "User",
      "description": "A registered user mapped by IP.",
      "type": "object",
      "properties": {
        "nickname": { "type": "string", "description": "The user's nickname." },
        "ip": { "type": "string", "description": "The user's IP address." },
        "createdAt": { "type": "string", "format": "date-time", "description": "When the user first joined." },
        "points": { "type": "number", "description": "The user's current point balance." },
        "isBanned": { "type": "boolean", "description": "Whether the user is banned." },
        "bannedUntil": { "type": "string", "format": "date-time", "description": "When the ban expires." },
        "isMuted": { "type": "boolean", "description": "Whether the user is muted (cannot send messages)." }
      },
      "required": ["nickname", "ip", "createdAt"]
    },
    "Notice": {
      "title": "Notice",
      "description": "A system notice displayed at the top of the chat.",
      "type": "object",
      "properties": {
        "text": { "type": "string", "description": "The content of the notice." },
        "updatedAt": { "type": "string", "format": "date-time", "description": "When the notice was last updated." },
        "author": { "type": "string", "description": "The admin who wrote the notice." }
      },
      "required": ["text", "updatedAt"]
    },
    "Message": {
      "title": "Message",
      "description": "A chat message sent by a user.",
      "type": "object",
      "properties": {
        "text": { "type": "string", "description": "The content of the message." },
        "imageUrl": { "type": "string", "description": "Optional image URL (base64)." },
        "senderNickname": { "type": "string", "description": "The nickname of the sender." },
        "senderIp": { "type": "string", "description": "The IP address of the sender." },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the message was sent." },
        "replyToId": { "type": "string", "description": "ID of the message being replied to." },
        "reactions": { "type": "object", "description": "Emoji reactions to the message." }
      },
      "required": ["senderNickname", "senderIp", "timestamp"]
    },
    "Log": {
      "title": "Log",
      "description": "A system log entry for tracking activities.",
      "type": "object",
      "properties": {
        "type": { "type": "string", "description": "The type of activity (e.g., join, leave, message)." },
        "content": { "type": "string", "description": "Details about the activity." },
        "timestamp": { "type": "string", "format": "date-time", "description": "When the activity occurred." },
        "ip": { "type": "string", "description": "The IP address associated with the activity." },
        "nickname": { "type": "string", "description": "The nickname associated with the activity." }
      },
      "required": ["type", "content", "timestamp", "ip"]
    },
    "UserSession": {
      "title": "UserSession",
      "description": "Information about a user's session.",
      "type": "object",
      "properties": {
        "nickname": { "type": "string", "description": "The user's chosen nickname." },
        "ip": { "type": "string", "description": "The user's IP address." },
        "lastActive": { "type": "string", "format": "date-time", "description": "Last time the user was active." }
      },
      "required": ["nickname", "ip", "lastActive"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of registered users."
    },
    "/notices/{noticeId}": {
      "schema": "Notice",
      "description": "Collection of system notices."
    },
    "/messages/{messageId}": {
      "schema": "Message",
      "description": "Collection of chat messages."
    },
    "/logs/{logId}": {
      "schema": "Log",
      "description": "Collection of system logs."
    },
    "/sessions/{sessionId}": {
      "schema": "UserSession",
      "description": "Collection of active user sessions."
    }
  }
}
